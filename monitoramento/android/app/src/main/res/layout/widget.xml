<?xml version="1.0" encoding="utf-8"?>
<!-- 1.2: cartao com altura propria; a area do launcher nunca estica o fundo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="top"
    android:background="@android:color/transparent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_widget"
        android:paddingLeft="9dp"
        android:paddingRight="9dp"
        android:paddingTop="5dp"
        android:paddingBottom="5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="19dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView android:id="@+id/widget_title"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="MONITORAMENTO RF"
                android:textStyle="bold"
                android:textSize="11sp"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#B0000000"
                android:shadowRadius="1.6"/>
            <TextView android:id="@+id/widget_refresh"
                android:layout_width="23dp"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="↻"
                android:textSize="19sp"
                android:textColor="#B3FFF5"
                android:contentDescription="Atualizar"/>
        </LinearLayout>

        <TextView android:id="@+id/widget_summary"
            android:layout_width="match_parent"
            android:layout_height="14dp"
            android:gravity="center_vertical"
            android:singleLine="true"
            android:ellipsize="end"
            android:text="Aguardando verificacao"
            android:textSize="9sp"
            android:textColor="#E0E7F1"/>

        <TextView android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66C4D0E2"/>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Sintercan"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#B0000000"
                android:shadowRadius="1.6"/>
            <TextView android:id="@+id/status_sintercan"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="AGUARDANDO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#B6C7D9"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="PSTEC"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#B0000000"
                android:shadowRadius="1.6"/>
            <TextView android:id="@+id/status_pstec"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="AGUARDANDO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#B6C7D9"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Anfeer"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#B0000000"
                android:shadowRadius="1.6"/>
            <TextView android:id="@+id/status_anfeer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="AGUARDANDO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#B6C7D9"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Columbia"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#B0000000"
                android:shadowRadius="1.6"/>
            <TextView android:id="@+id/status_columbia"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="AGUARDANDO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#B6C7D9"/>
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Brastorno"
                android:textSize="10sp"
                android:textColor="#FFFFFFFF"
                android:shadowColor="#B0000000"
                android:shadowRadius="1.6"/>
            <TextView android:id="@+id/status_brastorno"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:text="AGUARDANDO"
                android:textSize="9sp"
                android:textStyle="bold"
                android:textColor="#B6C7D9"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="#66C4D0E2" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="16dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <TextView android:id="@+id/widget_updated"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="Aguardando atualizacao"
                android:textSize="8sp"
                android:textColor="#DFE8F3" />
            <TextView android:id="@+id/widget_open"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:text="Abrir ›"
                android:textSize="9sp"
                android:textColor="#B3FFF5"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
