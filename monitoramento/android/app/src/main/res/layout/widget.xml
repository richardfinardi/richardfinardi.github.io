<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/bg_widget"
    android:paddingLeft="15dp"
    android:paddingRight="15dp"
    android:paddingTop="13dp"
    android:paddingBottom="12dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/widget_title"
            android:layout_width="0dp" android:layout_height="match_parent" android:layout_weight="1"
            android:gravity="center_vertical" android:text="MONITORAMENTO RF"
            android:textColor="#F2F7FF" android:textStyle="bold" android:textSize="14sp"/>
        <TextView android:id="@+id/widget_refresh"
            android:layout_width="36dp" android:layout_height="match_parent"
            android:gravity="center" android:text="↻" android:textSize="25sp"
            android:contentDescription="Atualizar" android:textColor="#7FDAD2"/>
    </LinearLayout>

    <TextView android:id="@+id/widget_summary" android:layout_width="match_parent"
        android:layout_height="25dp" android:gravity="center_vertical"
        android:text="Aguardando primeira verificação" android:textColor="#B6CADB" android:textSize="12sp"/>

    <TextView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#38516C" android:layout_marginBottom="6dp"/>

    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sintercan" android:textColor="#F2F7FF" android:textSize="13sp"/>
            <TextView android:id="@+id/status_sintercan" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AGUARDANDO" android:textSize="11sp" android:textStyle="bold" android:textColor="#97A9C1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="PSTEC" android:textColor="#F2F7FF" android:textSize="13sp"/>
            <TextView android:id="@+id/status_pstec" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AGUARDANDO" android:textSize="11sp" android:textStyle="bold" android:textColor="#97A9C1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Anfeer" android:textColor="#F2F7FF" android:textSize="13sp"/>
            <TextView android:id="@+id/status_anfeer" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AGUARDANDO" android:textSize="11sp" android:textStyle="bold" android:textColor="#97A9C1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Columbia" android:textColor="#F2F7FF" android:textSize="13sp"/>
            <TextView android:id="@+id/status_columbia" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AGUARDANDO" android:textSize="11sp" android:textStyle="bold" android:textColor="#97A9C1"/>
        </LinearLayout>
        <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
            <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Brastorno" android:textColor="#F2F7FF" android:textSize="13sp"/>
            <TextView android:id="@+id/status_brastorno" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AGUARDANDO" android:textSize="11sp" android:textStyle="bold" android:textColor="#97A9C1"/>
        </LinearLayout>
    </LinearLayout>

    <TextView android:layout_width="match_parent" android:layout_height="1dp"
        android:background="#38516C" android:layout_marginTop="5dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="28dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <TextView android:id="@+id/widget_updated" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:text="Atualização pendente" android:textColor="#A2B9CB" android:textSize="10sp"/>
        <TextView android:id="@+id/widget_open" android:layout_width="wrap_content" android:layout_height="match_parent"
            android:gravity="center_vertical" android:text="Abrir ›" android:textColor="#7FDAD2" android:textSize="11sp"/>
    </LinearLayout>
</LinearLayout>
